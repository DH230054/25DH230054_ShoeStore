@model _25DH230054_ShoeStore.Models.ViewModel.ProductSearchVM
@using PagedList.Mvc;

@{
    ViewBag.Title = "Trang chủ - Cửa hàng Giày";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-4">
    <!-- Banner chào mừng -->
    <div class="p-5 mb-4 bg-light rounded-3 shadow-sm text-center">
        <div class="container-fluid py-3">
            <h1 class="display-5 fw-bold text-success">CHÀO MỪNG ĐẾN VỚI SHOP GIÀY</h1>
            <p class="col-md-8 fs-4 mx-auto text-muted">Khám phá bộ sưu tập giày thể thao, sneaker và thời trang mới nhất với giá tốt nhất.</p>
        </div>
    </div>

    <!-- Form tìm kiếm và lọc giá ngoài trang chủ -->
    @using (Html.BeginForm("Index", "Home", FormMethod.Get))
    {
        <div class="row g-2 mb-4 bg-white p-3 rounded shadow-sm border">
            <div class="col-md-5">
                @Html.TextBoxFor(m => m.SearchTerm, new { @class = "form-control", placeholder = "Tìm kiếm tên giày, mô tả..." })
            </div>
            <div class="col-md-3">
                @Html.TextBoxFor(m => m.MinPrice, new { @class = "form-control", placeholder = "Giá tối thiểu", type = "number" })
            </div>
            <div class="col-md-3">
                @Html.TextBoxFor(m => m.MaxPrice, new { @class = "form-control", placeholder = "Giá tối đa", type = "number" })
            </div>
            <div class="col-md-1">
                <button type="submit" class="btn btn-primary w-100">🔍</button>
            </div>
        </div>
    }

    <!-- Danh sách sản phẩm dạng lưới (Grid) -->
    <div class="row">
        @if (Model.Products != null && Model.Products.Any())
        {
            foreach (var item in Model.Products)
            {
                <div class="col-md-3 mb-4">
                    <div class="card h-100 shadow-sm">
                        <img src="@Url.Content(item.ProductImage ?? "~/Content/images/default_img.png")" class="card-img-top p-3" style="height: 200px; object-fit: cover;" alt="@item.ProductName" />
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title fw-bold">@item.ProductName</h5>
                            <p class="card-text text-danger fw-bold fs-5">@string.Format("{0:N0} đ", item.ProductPrice)</p>
                            <div class="mt-auto">
                                @Html.ActionLink("Xem chi tiết & Chọn Size", "Details", new { id = item.ProductID }, new { @class = "btn btn-outline-success w-100" })
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <h4 class="text-muted">Không tìm thấy sản phẩm giày nào phù hợp!</h4>
            </div>
        }
    </div>

    <!-- Phân trang PagedList -->
    <div class="d-flex justify-content-center mt-4">
        @Html.PagedListPager(Model.Products, page => Url.Action("Index", new { page, searchTerm = Model.SearchTerm, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice }))
    </div>
</div>