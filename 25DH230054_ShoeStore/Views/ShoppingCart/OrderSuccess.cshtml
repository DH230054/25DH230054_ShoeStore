@{
    ViewBag.Title = "Đặt hàng thành công";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container text-center my-5 py-5">
    <div class="card shadow p-5 mx-auto" style="max-width: 600px;">
        <div class="mb-4">
            <span class="display-1 text-success">✅</span>
        </div>
        <h1 class="fw-bold text-success mb-3">Đặt Hàng Thành Công!</h1>
        <p class="text-muted fs-5 mb-4">Cảm ơn bạn đã mua sắm tại cửa hàng giày của chúng tôi. Đơn hàng của bạn đã được ghi nhận và đang được xử lý.</p>
        <div>
            @Html.ActionLink("Về trang chủ", "Index", "Home", null, new { @class = "btn btn-primary btn-lg" })
        </div>
    </div>
</div>