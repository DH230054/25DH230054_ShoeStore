@model _25DH230054_ShoeStore.Models.Cart

@{
    ViewBag.Title = "Thanh toán đơn hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-4">
    <h2 class="fw-bold mb-4">💳 Thông Tin Thanh Toán & Đặt Hàng</h2>

    <div class="row">
        <!-- Form nhập thông tin khách hàng -->
        <div class="col-md-7">
            <div class="card shadow-sm p-4">
                <h4 class="mb-3 text-success">Thông tin giao hàng</h4>
                @using (Html.BeginForm("Checkout", "ShoppingCart", FormMethod.Post))
                {
                    <div class="mb-3">
                        <label class="fw-bold">Họ tên người nhận:</label>
                        <input type="text" name="customerName" class="form-control" required placeholder="Nhập họ và tên..." />
                    </div>
                    <div class="mb-3">
                        <label class="fw-bold">Số điện thoại liên hệ:</label>
                        <input type="tel" name="customerPhone" class="form-control" required placeholder="Nhập số điện thoại..." />
                    </div>
                    <div class="mb-3">
                        <label class="fw-bold">Địa chỉ nhận hàng chi tiết:</label>
                        <textarea name="customerAddress" class="form-control" rows="3" required placeholder="Số nhà, tên đường, phường/xã, quận/huyện..."></textarea>
                    </div>
                    <button type="submit" class="btn btn-success btn-lg w-100 mt-3">Xác nhận Đặt hàng</button>
                }
            </div>
        </div>

        <!-- Tóm tắt đơn hàng -->
        <div class="col-md-5">
            <div class="card shadow-sm p-4 bg-light">
                <h4 class="mb-3">Đơn hàng của bạn (@Model.Items.Sum(i => i.Quantity) sản phẩm)</h4>
                <ul class="list-group mb-3">
                    @foreach (var item in Model.Items)
                    {
                        <li class="list-group-item d-flex justify-content-between lh-sm">
                            <div>
                                <h6 class="my-0">@item.ProductName</h6>
                                <small class="text-muted">Size: @item.SelectedSize | Màu: @item.SelectedColor | SL: @item.Quantity</small>
                            </div>
                            <span class="text-muted">@string.Format("{0:N0} đ", item.TotalPrice)</span>
                        </li>
                    }
                    <li class="list-group-item d-flex justify-content-between bg-white">
                        <span class="fw-bold">Tổng cộng:</span>
                        <strong class="text-danger fs-5">@string.Format("{0:N0} đ", Model.TotalValue())</strong>
                    </li>
                </ul>
                @Html.ActionLink("Quay lại giỏ hàng", "Index", "ShoppingCart", null, new { @class = "btn btn-outline-secondary w-100" })
            </div>
        </div>
    </div>
</div>